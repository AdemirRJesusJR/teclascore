<Window x:Class="Teclas.App.PerformanceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Desempenho · TeclaScore" Width="1080" Height="730" MinWidth="760" MinHeight="640"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/teclas.png"
 Background="{DynamicResource Background}" Foreground="{DynamicResource Ink}"
 FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="DIAGNÓSTICO LOCAL" Style="{StaticResource Eyebrow}"/>
   <TextBlock Text="Desempenho" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,8"/>
   <TextBlock Text="Confira o tempo das operações e identifique as etapas mais demoradas." Style="{StaticResource MutedText}"/>
  </StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
   <StackPanel><TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="Os registros ficam neste computador. Não incluem músicas, títulos, caminhos ou mensagens de erro. Nenhum relatório é enviado automaticamente." Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0"/>
   </StackPanel>
  </Border>
  <DataGrid x:Name="PerformanceRows" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" EnableRowVirtualization="True">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Horário" Binding="{Binding When}" Width="130"/>
    <DataGridTextColumn Header="Operação" Binding="{Binding Operation}" Width="*" MinWidth="180"/>
    <DataGridTextColumn Header="Processo" Binding="{Binding Process}" Width="95"/>
    <DataGridTextColumn Header="Resultado" Binding="{Binding Outcome}" Width="100"/>
    <DataGridTextColumn Header="Duração" Binding="{Binding Duration}" Width="85"/>
    <DataGridTextColumn Header="CPU¹" Binding="{Binding Cpu}" Width="85"/>
    <DataGridTextColumn Header="Pico²" Binding="{Binding Memory}" Width="90"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3" Margin="0,12,0,12">
   <TextBlock Text="¹ CPU do processo durante a medição; pode ser parcial. No aplicativo, inclui outras atividades simultâneas. Não inclui processos filhos." Style="{StaticResource MutedText}" FontSize="11"/>
   <TextBlock Text="² Maior pico de memória observado desde o início do processo; não é a memória consumida apenas pela operação. — indica medição indisponível." Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/>
   <TextBlock Text="Durações de operações simultâneas ou de processos diferentes não devem ser somadas. Concluída indica que a etapa terminou sem lançar uma falha." Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/>
   <TextBlock x:Name="ReportStatus" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,9,0,0"/>
  </StackPanel>
  <WrapPanel x:Name="Actions" Grid.Row="4" HorizontalAlignment="Right">
   <Button Content="Atualizar" Click="RefreshClick" Margin="0,0,8,0"/>
   <Button Content="Limpar registros" Click="ClearClick" Margin="0,0,8,0" ToolTip="Apaga somente os registros de desempenho locais."/>
   <Button Content="Exportar relatório" Click="ExportClick" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"/>
   <Button Content="Fechar" IsCancel="True"/>
  </WrapPanel>
 </Grid>
</Window>
