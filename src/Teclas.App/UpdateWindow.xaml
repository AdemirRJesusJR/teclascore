<Window x:Class="Teclas.App.UpdateWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Atualizações e diagnóstico" Width="690" Height="650" MinWidth="560" MinHeight="520"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/teclas.png"
 Background="{DynamicResource Background}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13">
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="TECLASCORE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Atualizações e diagnóstico" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,6"/><TextBlock x:Name="InstalledVersionText" Style="{StaticResource MutedText}"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
     <StackPanel><TextBlock Text="Versões do aplicativo" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock x:Name="UpdateStatusText" Text="Clique em Verificar para consultar as versões publicadas no GitHub." Style="{StaticResource MutedText}" Margin="0,9,0,14"/>
      <WrapPanel><Button x:Name="CheckUpdateButton" Content="Verificar atualização" Click="CheckUpdateClick" Margin="0,0,8,8"/><Button Content="Abrir versões no GitHub" Click="OpenReleasesClick" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock Text="Para um repositório privado, entre no GitHub pelo navegador. Baixe o ZIP e o arquivo SHA256SUMS da mesma versão." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,12"/>
      <Button x:Name="InstallUpdateButton" Content="Instalar pacote baixado…" Click="InstallUpdateClick" HorizontalAlignment="Left"/>
      <TextBlock Text="A instalação é feita somente para seu usuário. Suas configurações, biblioteca e partituras são preservadas." Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Dependências para gerar partituras" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock x:Name="DiagnosticsText" Text="Confira o .NET, o Python com Pillow e o MuseScore configurados." Style="{StaticResource MutedText}" Margin="0,9,0,14"/>
     <Button x:Name="DiagnosticsButton" Content="Executar diagnóstico" Click="DiagnosticsClick" HorizontalAlignment="Left"/>
     <TextBlock Text="Ajuste os caminhos do Python e do MuseScore em Configurações quando necessário." Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/>
    </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
  <Button Grid.Row="2" x:Name="CloseUpdateButton" Content="Fechar" IsCancel="True" HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="90"/>
 </Grid>
</Window>
