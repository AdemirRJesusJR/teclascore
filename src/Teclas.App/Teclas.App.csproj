<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Teclas.Partituras</AssemblyName>
    <Version>0.38.0</Version>
    <Product>TeclaScore</Product>
    <Title>TeclaScore</Title>
    <Description>Partituras de teclado a partir de arquivos MIDI.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/teclas.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Teclas.Core/Teclas.Core.csproj" />
    <Resource Include="Assets/teclas.png" />
    <Resource Include="Assets/teclas.ico" />
    <Content Include="../../engine/**" Exclude="../../engine/**/__pycache__/**;../../engine/**/*.pyc">
      <Link>engine/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
