<Window x:Class="Teclas.App.ScorePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Propriedades da partitura" Width="640" Height="690" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/teclas.png"
        Background="{DynamicResource Background}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20">
   <TextBlock Text="CABEÇALHO E DIAGRAMAS" Style="{StaticResource Eyebrow}"/>
   <TextBlock Text="Propriedades da partitura" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,7"/>
   <TextBlock Text="Personalize as informações e os acordes desta música." Style="{StaticResource MutedText}" FontSize="12"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,4,0">
    <StackPanel>
     <Label Content="Título" Target="{Binding ElementName=ScoreTitleInput}" Foreground="{DynamicResource Ink}" Padding="0" FontWeight="SemiBold"/>
     <TextBox x:Name="ScoreTitleInput" MaxLength="160" Margin="0,7,0,18" AutomationProperties.Name="Título da partitura"/>
     <Label Content="Subtítulo" Target="{Binding ElementName=ScoreSubtitleInput}" Foreground="{DynamicResource Ink}" Padding="0" FontWeight="SemiBold"/>
     <TextBox x:Name="ScoreSubtitleInput" MaxLength="200" TextChanged="SubtitleChanged" Margin="0,7,0,10" AutomationProperties.Name="Subtítulo da partitura"/>
     <CheckBox x:Name="AutomaticSubtitleCheck" Content="Subtítulo automático conforme os diagramas" Checked="AutomaticSubtitleChanged" Unchecked="AutomaticSubtitleChanged" FontSize="12" Margin="0,0,0,18"/>
     <Label Content="Autor / compositor" Target="{Binding ElementName=ScoreComposerInput}" Foreground="{DynamicResource Ink}" Padding="0" FontWeight="SemiBold"/>
     <TextBox x:Name="ScoreComposerInput" MaxLength="120" Margin="0,7,0,18" AutomationProperties.Name="Autor ou compositor"/>
     <Label Content="Posição dos acordes nos diagramas" Target="{Binding ElementName=DiagramInversionCombo}" Foreground="{DynamicResource Ink}" Padding="0" FontWeight="SemiBold"/>
     <ComboBox x:Name="DiagramInversionCombo" SelectedValuePath="Value" DisplayMemberPath="Label" SelectionChanged="InversionChanged" Margin="0,7,0,10" AutomationProperties.Name="Inversão dos diagramas desta partitura"/>
     <TextBlock Text="O padrão adotado é o que esta partitura recebeu ao ser adicionada. Alterações em Configurações valem para novas partituras." Style="{StaticResource MutedText}" FontSize="11"/>
    </StackPanel>
   </Border>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,20,0,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="PropertiesValidationMessage" Foreground="{DynamicResource Error}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Subtítulo e autor podem ficar vazios." Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>
    <Button x:Name="CancelPropertiesButton" Grid.Column="1" Content="Cancelar" IsCancel="True" MinWidth="90" Margin="0,0,10,0"/>
    <Button x:Name="SavePropertiesButton" Grid.Column="2" Content="Aplicar e atualizar" IsDefault="True" Click="SavePropertiesClick" Style="{StaticResource PrimaryButton}" MinWidth="160"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
