<Window x:Class="Teclas.App.DependencySetupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Preparar este computador" Width="800" Height="780" MinWidth="640" MinHeight="620"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/teclas.png"
 Background="{DynamicResource Background}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13">
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="PRIMEIROS PASSOS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Preparar este computador" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,8"/><TextBlock Text="Encontre e confira os programas necessários. Os caminhos só são salvos ao clicar em Usar estas configurações." Style="{StaticResource MutedText}"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="SetupFields">
    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="1 · .NET Desktop" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock x:Name="RuntimeStatus" Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="2 · Python e Pillow" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="Python 3.11 ou superior. Pillow prepara as imagens usadas nas partituras." Style="{StaticResource MutedText}" Margin="0,7,0,10"/>
     <DockPanel><Button x:Name="BrowsePythonButton" DockPanel.Dock="Right" Content="Localizar…" Click="BrowsePythonClick" Margin="8,0,0,0"/><TextBox x:Name="PythonPathBox" TextChanged="PathsChanged" AutomationProperties.Name="Caminho do Python" VerticalContentAlignment="Center"/></DockPanel>
     <TextBlock x:Name="PythonStatus" Text="Ainda não conferido." TextWrapping="Wrap" Margin="0,9,0,9"/>
     <WrapPanel><Button x:Name="PythonDownloadButton" Content="Baixar Python oficial ↗" Click="DownloadPythonClick" Margin="0,0,8,8"/><Button x:Name="PreparePythonButton" Content="Preparar Python do TeclaScore" Click="PreparePythonClick" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel>
     <TextBlock Text="Preparar cria um ambiente separado e baixa Pillow do PyPI. Requer internet e não muda seu Python atual. Depois de instalar Python pelo site, clique em Detectar e verificar." Style="{StaticResource MutedText}" FontSize="12"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="3 · MuseScore Studio 4" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="Usado para gerar a partitura, a prévia, o PDF e o áudio. O teste usa uma página de exemplo, sem acessar sua biblioteca." Style="{StaticResource MutedText}" Margin="0,7,0,10"/>
     <DockPanel><Button x:Name="BrowseMuseScoreButton" DockPanel.Dock="Right" Content="Localizar…" Click="BrowseMuseScoreClick" Margin="8,0,0,0"/><TextBox x:Name="MuseScorePathBox" TextChanged="PathsChanged" AutomationProperties.Name="Caminho do MuseScore" VerticalContentAlignment="Center"/></DockPanel>
     <TextBlock x:Name="MuseScoreStatus" Text="Ainda não conferido." TextWrapping="Wrap" Margin="0,9,0,9"/>
     <Button x:Name="MuseScoreDownloadButton" Content="Baixar MuseScore oficial ↗" Click="DownloadMuseScoreClick" HorizontalAlignment="Left"/>
     <TextBlock Text="Conclua a instalação e abra o MuseScore uma vez. Volte aqui e clique em Detectar e verificar." Style="{StaticResource MutedText}" FontSize="12" Margin="0,9,0,0"/>
    </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="SetupStatus" Text="Nenhum programa é baixado ou instalado ao abrir esta janela." TextWrapping="Wrap"/><ProgressBar x:Name="SetupProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0"/></StackPanel>
  <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button x:Name="CheckDependenciesButton" Content="Detectar e verificar" Click="CheckDependenciesClick" Margin="0,0,8,8"/>
   <Button x:Name="CancelSetupButton" Content="Fechar" Click="CancelSetupClick" Margin="0,0,8,8"/>
   <Button x:Name="ApplyDependenciesButton" Content="Usar estas configurações" Click="ApplyDependenciesClick" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,0,8"/>
  </WrapPanel>
 </Grid>
</Window>
