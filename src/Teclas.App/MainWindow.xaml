tions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding KeyboardKeys}" Margin="0,0,16,6" ToolTip="O app avisa quando a melodia passa da extensão do seu teclado e sugere a oitava; a lista inteligente Não cabem no meu teclado reúne essas músicas" AutomationProperties.Name="Número de teclas do meu teclado"/><TextBlock Text="Tamanho" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox x:Name="ScoreSizeCombo" Width="200" ItemsSource="{Binding ScoreSizeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ScoreSize}" Margin="0,0,16,6" AutomationProperties.Name="Tamanho das partituras"/><TextBlock Text="Espaço entre as pautas" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox x:Name="ScoreSpacingCombo" Width="230" ItemsSource="{Binding ScoreSpacingOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ScoreSpacing}" Margin="0,0,0,6" ToolTip="Distância vertical entre uma linha da partitura e a próxima. Compacto: menos espaço vazio e mais música por página. Amplo: mais respiro para escrever anotações. Em todos, cifras, diagramas, letras e nomes de instrumento continuam sem se sobrepor; o tamanho das notas não muda" AutomationProperties.Name="Espaço entre as pautas"/></WrapPanel><WrapPanel Margin="0,0,0,8"><TextBlock Text="Diagramas" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox x:Name="DiagramStyleCombo" Width="230" ItemsSource="{Binding DiagramStyleOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DiagramStyle}" Margin="0,0,16,6" ToolTip="Pontos: teclas brancas com um ponto em cada nota do acorde e a nota do grave num círculo vazado, sem letras. Destacado: teclas do acorde pintadas e com o nome da nota, numa janela de 10 teclas largas que acompanha o acorde; a nota do grave fica mais escura. Cinza: o mesmo desenho para imprimir em preto e branco. Clássico: o desenho anterior, com pontos" AutomationProperties.Name="Desenho dos diagramas de teclado"/><CheckBox x:Name="PageFooterCheckBox" Content="Número da página no rodapé" IsChecked="{Binding PageFooter}" VerticalAlignment="Center" Margin="0,0,16,6" ToolTip="Escreve &quot;página X de Y&quot; no pé de cada página, para as folhas soltas não se misturarem" AutomationProperties.Name="Rodapé com título e número da página"/><CheckBox x:Name="CleanDurationsCheckBox" Content="Durações legíveis" IsChecked="{Binding CleanDurations}" VerticalAlignment="Center" Margin="0,0,16,6" ToolTip="Escreve as notas da melodia sem cadeias de pausas minúsculas: preenche pausas menores que meio tempo e arredonda notas curtíssimas até a colcheia. Os ataques não mudam de lugar; perfis revisados ficam como foram aprovados" AutomationProperties.Name="Escrever durações legíveis"/><CheckBox x:Name="PdfChordPageCheckBox" Content="Página de acordes no PDF" IsChecked="{Binding PdfChordPage}" VerticalAlignment="Center" Margin="0,0,0,6" ToolTip="Acrescenta ao fim de cada PDF uma página com todos os acordes da música e seus diagramas grandes; também preenche título e intérprete nas propriedades do PDF" AutomationProperties.Name="Página de acordes ao fim do PDF"/><CheckBox x:Name="PdfMusicMapCheckBox" Content="Mapa da música no PDF" IsChecked="{Binding PdfMusicMap}" VerticalAlignment="Center" Margin="16,0,0,6" ToolTip="Acrescenta ao PDF uma página com os acordes compasso por compasso, separados pelas partes da música (Intro, A, Refrão…), para tocar só pela cifra" AutomationProperties.Name="Mapa da música no PDF"/><CheckBox x:Name="SectionMarksCheckBox" Content="Nomes das partes" IsChecked="{Binding SectionMarks}" VerticalAlignment="Center" Margin="16,0,0,6" ToolTip="Marca onde começam as partes da música (Intro, A, B, Refrão, Instrumental, Final) e começa cada uma num sistema novo. As partes vêm da letra e das repetições do MIDI; música sem partes claras fica sem marcas" AutomationProperties.Name="Nomes das partes da música"/><CheckBox x:Name="HeaderInfoCheckBox" Content="Tom e andamento no cabeçalho" IsChecked="{Binding HeaderInfo}" VerticalAlignment="Center" Margin="16,0,0,6" ToolTip="Escreve abaixo do título o tom (e o original, se transposta), o compasso e o andamento" AutomationProperties.Name="Tom, compasso e andamento no cabeçalho"/></WrapPanel><TextBlock Text="Biblioteca em vários computadores" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="Escolha uma pasta sincronizada (OneDrive, Google Drive, Dropbox ou pen drive). Ao fechar, o app envia a biblioteca se ela mudou; no outro computador, ao abrir, ele oferece as músicas novas. As músicas que já estão em cada computador ficam como estão." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/><WrapPanel><Button x:Name="ChooseLibrarySyncFolderButton" Content="Escolher pasta…" Click="ChooseLibrarySyncFolderClick" IsEnabled="{Binding IsIdle}" Margin="0,0,8,8"/><Button x:Name="SyncLibraryNowButton" Content="Sincronizar agora" Click="SyncLibraryNowClick" IsEnabled="{Binding CanSyncLibrary}" Margin="0,0,8,8"/><Button Content="Desligar" Click="TurnOffLibrarySyncClick" IsEnabled="{Binding CanSyncLibrary}" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="{Binding LibrarySyncFolder}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding LibrarySyncStatus}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"/><TextBlock Text="Arquivos indisponíveis são identificados antes de salvar. A fila de conversões e os arquivos temporários de análise e áudio ficam neste computador." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border>
     <Border x:Name="OutputDirectoryCard" Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
      <TextBlock Text="Pasta de saída padrão" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Escolha a pasta padrão para novas partituras. PDF e ZIP lembram a última pasta usada ao salvar; Salvar pasta padrão redefine também o destino da próxima exportação. Arquivos existentes e trabalhos já enfileirados mantêm seus destinos." Style="{StaticResource MutedText}" Margin="0,6,0,16"/>
      <Label Content="Pasta para partituras e exportações" Target="{Binding ElementName=OutputDirectoryBox}" Foreground="{DynamicResource Ink}" Padding="0"/>
      <TextBox x:Name="OutputDirectoryBox" Text="{Binding OutputDirectoryDraft,UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,12" AutomationProperties.Name="Pasta de saída padrão"/>
      <WrapPanel><Button x:Name="BrowseOutputDirectoryButton" Content="Escolher pasta…" Click="BrowseOutput" Margin="0,0,8,8"/><Button x:Name="SaveOutputDirectoryButton" Content="Salvar pasta padrão" Click="SaveOutputDirectoryClick" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock x:Name="OutputDirectoryStatusText" Text="{Binding OutputDirectoryStatus}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding OutputDirectoryHasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Error}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </StackPanel></Border>
     <Border x:Name="MidiFolderWatchCard" Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Pasta acompanhada" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Opcional. Os MIDIs novos que chegarem à Pasta de MIDIs viram cards sozinhos, também os que chegarem com o app fechado. Os que já estão na pasta continuam de fora até você marcá-los." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,10"/><WrapPanel><CheckBox x:Name="WatchMidiFolderCheckBox" Content="Acompanhar a Pasta de MIDIs" IsChecked="{Binding WatchMidiFolderEnabled}" VerticalAlignment="Center" Margin="0,0,16,8" ToolTip="Acompanhar a Pasta de MIDIs: cada MIDI novo (.mid, .midi, .kar) vira um card quando termina de ser gravado, sem copiar nem repetir arquivos, com um aviso no rodapé." AutomationProperties.Name="Acompanhar a Pasta de MIDIs"/><CheckBox x:Name="WatchMidiFolderAutopilotCheckBox" Content="Gerar sozinho com o Piloto automático" IsChecked="{Binding WatchMidiFolderAutopilot}" IsEnabled="{Binding WatchMidiFolderEnabled}" VerticalAlignment="Center" Margin="0,0,16,8" ToolTip="Gerar sozinho com o Piloto automático: os cards novos vão para o Piloto, que gera as partituras de melodia clara; MIDIs sem melodia completa ou com melodia duvidosa esperam a sua escolha." AutomationProperties.Name="Gerar sozinho com o Piloto automático os MIDIs novos da pasta"/><Button x:Name="ChooseWatchedFolderButton" Content="Escolher pasta…" Click="ChooseWatchedFolderClick" IsEnabled="{Binding IsIdle}" Margin="0,0,8,8" ToolTip="Escolher a Pasta de MIDIs (a mesma da janela Pasta de MIDIs, Ctrl+L)"/></WrapPanel><TextBlock x:Name="MidiFolderWatchStatusText" Text="{Binding MidiFolderWatchStatus}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
     <Border x:Name="StudySettingsCard" Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Estudo" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Ajuste da contagem antes de tocar: se a música entrar atrasada depois da contagem, aumente; se entrar adiantada, diminua. Teste na Prévia com a Contagem ligada." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,12"/><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding CountInLeadMilliseconds,StringFormat={}{0} ms}" Width="60" TextAlignment="Right" VerticalAlignment="Center"/><Slider x:Name="CountInLeadSlider" Minimum="0" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="50" Value="{Binding CountInLeadMilliseconds,Mode=TwoWay}" AutomationProperties.Name="Ajuste da contagem em milissegundos"/></DockPanel><TextBlock Text="{Binding CountInLeadText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Ferramentas de conversão" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="O TeclaScore usa o MuseScore para salvar e conferir suas partituras." Style="{StaticResource MutedText}" Margin="0,6,0,22"/><Button x:Name="DependencySetupButton" Content="Preparar este computador" Click="DependencySetupClick" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" Margin="0,0,0,18" Style="{StaticResource SoftButton}"/><TextBlock Text="MuseScore Studio 4" FontWeight="SemiBold"/><DockPanel Margin="0,8,0,20"><Button DockPanel.Dock="Right" Content="Localizar…" Click="BrowseMuseScore" Margin="12,0,0,0"/><TextBox Text="{Binding MuseScorePath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Caminho do MuseScore"/></DockPanel><TextBlock Text="Motor musical · Python com Pillow" FontWeight="SemiBold"/><DockPanel Margin="0,8,0,14"><Button DockPanel.Dock="Right" Content="Localizar…" Click="BrowsePython" Margin="12,0,0,0"/><TextBox Text="{Binding PythonPath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Caminho do Python"/></DockPanel><TextBlock Text="A interface e a leitura MIDI são em C#. Esta versão utiliza o motor musical em Python já validado com suas partituras." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border>
     <Border x:Name="ChordNotationCard" Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Escrita das cifras" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Como os acordes aparecem nas partituras e na cifra em texto. Os diagramas não mudam." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,10"/><WrapPanel><TextBlock Text="Sétima maior" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox x:Name="NotationMajor7Combo" Width="90" ItemsSource="{Binding Major7Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NotationMajor7}" Margin="0,0,16,6" AutomationProperties.Name="Escrita da sétima maior"/><TextBlock Text="Meio-diminuto" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox Width="100" ItemsSource="{Binding HalfDiminishedOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NotationHalfDiminished}" Margin="0,0,16,6" AutomationProperties.Name="Escrita do meio-diminuto"/><TextBlock Text="Diminuto" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox Width="80" ItemsSource="{Binding DiminishedOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NotationDiminished}" Margin="0,0,16,6" AutomationProperties.Name="Escrita do diminuto"/><TextBlock Text="Nona adicionada" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox Width="90" ItemsSource="{Binding Add9Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NotationAdd9}" Margin="0,0,16,6" AutomationProperties.Name="Escrita da nona adicionada"/><TextBlock Text="Acidentes" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox Width="190" ItemsSource="{Binding AccidentalOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NotationAccidentals}" Margin="0,0,16,6" AutomationProperties.Name="Bemóis ou sustenidos nas cifras"/></WrapPanel><TextBlock x:Name="NotationPreviewText" Text="{Binding NotationPreview}" FontWeight="SemiBold" Margin="0,6,0,0"/><DockPanel Margin="0,8,0,0"><Button x:Name="ApplyNotationButton" Content="Aplicar à biblioteca" Click="ApplyNotationClick" DockPanel.Dock="Right" Margin="12,0,0,0" AutomationProperties.Name="Aplicar a escrita das cifras às partituras geradas"/><TextBlock Text="{Binding NotationApplyHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></StackPanel></Border>
     <Border x:Name="MicrophoneCard" Style="{StaticResource Card}" Margin="0,0,0,18"><DockPanel><Button x:Name="MicrophoneTestButton" Content="Testar microfone" Click="MicrophoneTestClick" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Testar microfone"/><StackPanel><TextBlock Text="Microfone" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Usado para praticar num piano acústico, medir a sua voz e buscar cantarolando. O teste mostra o volume e a nota reconhecida, e ajuda quando o Windows bloqueia o microfone." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
     <Border x:Name="TeacherKeyCard" Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Professor com IA" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Opcional. Com uma chave da Anthropic, o botão Professor da prévia responde perguntas sobre a música aberta usando o Claude. Ao perguntar, só o título, a cifra com a letra e seus resultados de prática dessa música são enviados." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,12"/><DockPanel><Button Content="Remover" Click="RemoveTeacherKeyClick" IsEnabled="{Binding HasTeacherKey}" DockPanel.Dock="Right" Margin="8,0,0,0" AutomationProperties.Name="Remover chave do professor"/><Button Content="Guardar chave" Click="SaveTeacherKeyClick" DockPanel.Dock="Right" Margin="8,0,0,0" AutomationProperties.Name="Guardar chave do professor"/><PasswordBox x:Name="TeacherKeyBox" MinHeight="32" VerticalContentAlignment="Center" AutomationProperties.Name="Chave da API da Anthropic" ToolTip="Fica no Gerenciador de Credenciais do Windows, fora das configurações, backups e sincronização"/></DockPanel><TextBlock x:Name="TeacherKeyStatusText" Text="{Binding TeacherKeyStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Background="{DynamicResource Soft}" CornerRadius="12" Padding="22"><StackPanel><TextBlock Text="O padrão que você aprovou" FontWeight="SemiBold"/><TextBlock Text="Melodia em uma pauta, cifras e diagramas de teclado com inversão configurável. O padrão inicial é a segunda inversão. Os diagramas são incorporados como imagens; ao mudar uma cifra dentro do MuseScore, atualize também o desenho." Style="{StaticResource MutedText}" Margin="0,8,0,8"/><TextBlock Text="Tema, menu lateral, pastas e preparação musical ficam salvos para a próxima abertura." FontSize="11" Foreground="{DynamicResource SoftInk}"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer Visibility="{Binding AboutVisible}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Image Source="Assets/teclas.png" Width="84" Height="84" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Ícone do TeclaScore"/>
       <StackPanel Grid.Column="1"><TextBlock Text="SEU ESTÚDIO DE PARTITURAS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding AppDisplayName}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,8"/><Border Background="{DynamicResource Soft}" CornerRadius="6" Padding="11,5" HorizontalAlignment="Left"><TextBlock x:Name="AboutVersionText" Text="{Binding AppVersionLabel}" Foreground="{DynamicResource SoftInk}" FontWeight="SemiBold" FontSize="12"/></Border><TextBlock Text="Do MIDI à partitura de teclado: organize seu repertório, escolha a melodia e confira as cifras antes de gerar seus arquivos MuseScore." Style="{StaticResource MutedText}" Margin="0,18,0,0" MaxWidth="690" HorizontalAlignment="Left"/></StackPanel>
      </Grid></Border>
      <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Feito para tocar no teclado" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Uma pauta de melodia, cifras e diagramas de acordes. Inversão configurável; padrão inicial na 2ª inversão." Style="{StaticResource MutedText}" Margin="0,10,0,14"/><TextBlock Text="Seu espaço, do seu jeito" FontWeight="SemiBold"/><TextBlock Text="Cinco temas, menu lateral recolhível e restauração das suas preferências e da preparação musical." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ferramentas de conversão" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="MuseScore Studio 4 e Python com Pillow são usados para gerar os arquivos e conferir as prévias." Style="{StaticResource MutedText}" Margin="0,10,0,14"/><TextBlock Text="Configure os caminhos dessas ferramentas na página Configurações." Style="{StaticResource MutedText}"/><Button x:Name="PerformanceButton" Content="Desempenho" Click="PerformanceClick" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" Margin="0,14,0,0"/><Button Content="Instalação e atualizações" Click="UpdatesClick" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" Margin="0,14,0,0"/><Button x:Name="SupportReportButton" Content="Relatório de problema…" Click="SupportReportClick" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="Gera um arquivo ZIP com informações para entender um problema, sem pastas pessoais nem a lista da biblioteca" AutomationProperties.Name="Gerar relatório de problema"/><CheckBox x:Name="AutoCheckUpdatesCheckBox" Content="Avisar quando houver versão nova (consulta o GitHub uma vez por dia)" IsChecked="{Binding AutoCheckUpdates}" Margin="0,10,0,0" ToolTip="Só avisa: nada é baixado ou instalado sem o seu clique no botão Atualizar."/><Button x:Name="ShortcutsButton" Content="Atalhos de teclado (F1)" Click="ShortcutsClick" HorizontalAlignment="Left" Margin="0,14,0,0"/><Button Content="Abrir configurações  →" Tag="settings" Click="NavigationClick" Style="{StaticResource SoftButton}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Projeto no GitHub" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Código-fonte e histórico de versões do TeclaScore." Style="{StaticResource MutedText}" Margin="0,6,0,6"/><TextBlock Text="{Binding RepositoryUrl}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Abrir repositório  ↗" Click="OpenRepositoryClick" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" AutomationProperties.Name="Abrir repositório TeclaScore no GitHub"/></Grid></Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
    <Grid Margin="28,10"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Ellipse Width="7" Height="7" Fill="{DynamicResource Ready}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
      <TextBlock x:Name="FooterOperationStatus" Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" MaxHeight="32" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite"/>
      <ProgressBar x:Name="FooterOperationProgressBar" IsIndeterminate="{Binding OperationFooterProgressIndeterminate}" Value="{Binding OperationProgressValue,Mode=OneWay}" Minimum="0" Maximum="100" Height="2" BorderThickness="0" Margin="0,5,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource ChartTrack}" AutomationProperties.Name="Progresso da operação"/>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="BackgroundQueueButton" Visibility="{Binding BackgroundQueueVisibility}" Content="{Binding BackgroundQueueText}" Click="BackgroundQueueClick" IsEnabled="{Binding IsIdle}" Padding="10,6" MinHeight="30" FontSize="11" Margin="0,0,6,0" ToolTip="{Binding BackgroundQueueToolTip}" AutomationProperties.Name="Fila de conversões em segundo plano"/>
      <Button x:Name="PauseBackgroundQueueButton" Visibility="{Binding BackgroundQueueVisibility}" Content="Pausar fila" Click="PauseBackgroundQueueClick" IsEnabled="{Binding CanPauseBackgroundQueue}" Padding="10,6" MinHeight="30" FontSize="11" Margin="0,0,8,0" ToolTip="Pausar a fila em segundo plano: as partituras prontas ficam salvas e as interrompidas aguardam na Fila de conversões para retomar" AutomationProperties.Name="Pausar a fila de conversões"/>
      <Button x:Name="UndoLibraryRemovalButton" Visibility="{Binding LibraryUndoVisibility}" Content="↶  Desfazer remoção" Click="UndoRemoveLibraryItemClick" IsEnabled="{Binding CanUndoLibraryRemoval}" Padding="10,6" MinHeight="30" FontSize="11" Margin="0,0,8,0" ToolTip="Restaura os cards da última remoção, com suas edições."/>
      <Button x:Name="FooterOperationCancelButton" Content="{Binding OperationCancelLabel}" Click="CancelClick" IsEnabled="{Binding CanCancelOperation}" Padding="12,6" MinHeight="30" FontSize="11" ToolTip="Cancelar a preparação de áudio ou a operação em andamento" AutomationProperties.Name="{Binding OperationCancelLabel}"/>
     </StackPanel>
    </Grid>
   </Border>
 </Grid>
 <Grid x:Name="OperationOverlay" Visibility="{Binding OperationVisibility}" Background="#99000000" Panel.ZIndex="100"
       KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
  <Border x:Name="OperationCard" Width="540" Padding="30" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center"
          Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
   <StackPanel>
    <DockPanel Margin="0,0,0,18">
     <Grid Width="34" Height="34" Margin="0,0,14,0" DockPanel.Dock="Left">
      <Ellipse Stroke="{DynamicResource ChartTrack}" StrokeThickness="3"/>
      <Path Data="M 17,2 A 15,15 0 0 1 32,17" Stroke="{DynamicResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
       <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
       <Path.Style><Style TargetType="Path"><Style.Triggers>
        <DataTrigger Binding="{Binding IsModalOperation}" Value="True">
         <DataTrigger.EnterActions><BeginStoryboard x:Name="OperationSpin"><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.1" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
         <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="OperationSpin"/></DataTrigger.ExitActions>
        </DataTrigger>
       </Style.Triggers></Style></Path.Style>
      </Path>
     </Grid>
     <TextBlock Text="{Binding OperationTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock Text="{Binding OperationItem}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OperationItem}" Margin="0,0,0,18"/>
    <TextBlock Text="{Binding Status}" FontSize="14" TextWrapping="Wrap" MinHeight="44" MaxHeight="100" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite"/>
    <ProgressBar x:Name="OperationProgressBar" Height="8" Margin="0,18,0,12" Minimum="0" Maximum="100"
                 Value="{Binding OperationProgressValue,Mode=OneWay}" IsIndeterminate="{Binding OperationProgressIndeterminate}"
                 AutomationProperties.Name="Progresso da operação"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding OperationCountText}" Foreground="{DynamicResource Muted}" FontSize="12"/>
     <TextBlock Grid.Column="1" Text="{Binding OperationElapsedText}" Foreground="{DynamicResource Muted}" FontSize="12"/>
    </Grid>
    <Button x:Name="OperationCancelButton" Content="{Binding OperationCancelLabel}" IsEnabled="{Binding CanCancelOperation}" Click="CancelClick" HorizontalAlignment="Right" MinWidth="150" Margin="0,24,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
 </Grid>
</Window>
