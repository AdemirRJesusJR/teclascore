     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="dashboard"><Setter Property="Background" Value="{DynamicResource SidebarActive}"/><Setter Property="Foreground" Value="{DynamicResource SidebarInk}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     <StackPanel Orientation="Horizontal"><TextBlock Text="◫" FontFamily="Segoe UI Symbol" FontSize="20" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Visão geral" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding ExpandedSidebarVisible}"/></StackPanel>
    </Button>
    <Button Tag="library" Click="NavigationClick" ToolTip="Biblioteca (Ctrl+2)" AutomationProperties.Name="Biblioteca" Padding="10,10" HorizontalContentAlignment="{Binding SidebarContentAlignment}">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="library"><Setter Property="Background" Value="{DynamicResource SidebarActive}"/><Setter Property="Foreground" Value="{DynamicResource SidebarInk}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     <StackPanel Orientation="Horizontal"><TextBlock Text="♫" FontFamily="Segoe UI Symbol" FontSize="20" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Biblioteca" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding ExpandedSidebarVisible}"/></StackPanel>
    </Button>
    <Button Tag="production" Click="NavigationClick" ToolTip="Produção (Ctrl+3)" AutomationProperties.Name="Produção" Padding="10,10" HorizontalContentAlignment="{Binding SidebarContentAlignment}">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="production"><Setter Property="Background" Value="{DynamicResource SidebarActive}"/><Setter Property="Foreground" Value="{DynamicResource SidebarInk}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     <StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontFamily="Segoe UI Symbol" FontSize="20" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Produção" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding ExpandedSidebarVisible}"/></StackPanel>
    </Button>
    <Button x:Name="PresentationButton" Click="OpenPresentationClick" IsEnabled="{Binding CanOpenPresentation}" ToolTip="Modo apresentação" AutomationProperties.Name="Modo apresentação" Style="{StaticResource NavButton}" Padding="10,10" HorizontalContentAlignment="{Binding SidebarContentAlignment}"><StackPanel Orientation="Horizontal"><TextBlock Text="▷" FontFamily="Segoe UI Symbol" FontSize="20" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Apresentação" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding ExpandedSidebarVisible}"/></StackPanel></Button>
    <Button x:Name="RecoverDraftsButton" Click="OpenDraftRecoveryClick" IsEnabled="{Binding CanRecoverDrafts}" ToolTip="Recuperar rascunhos" AutomationProperties.Name="Recuperar rascunhos" Style="{StaticResource NavButton}" Padding="10,10" HorizontalContentAlignment="{Binding SidebarContentAlignment}"><StackPanel Orientation="Horizontal"><TextBlock Text="↶" FontFamily="Segoe UI Symbol" FontSize="20" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding DraftRecoveryLabel}" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding ExpandedSidebarVisible}"/></StackPanel></Button>
    <Border BorderBrush="{DynamicResource SidebarLine}" BorderThickness="0,1,0,0" Margin="10,10,10,14"/>
    <Button Tag="settings" Click="NavigationClick" ToolTip="Configurações (Ctrl+,)" AutomationProperties.Name="Configurações" Padding="10,10" HorizontalContentAlignment="{Binding SidebarContentAlignment}">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="settings"><Setter Property="Background" Value="{DynamicResource SidebarActive}"/><Setter Property="Foreground" Value="{DynamicResource SidebarInk}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="20" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Configurações" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding ExpandedSidebarVisible}"/></StackPanel>
    </Button>
    <Button Tag="about" Click="NavigationClick" ToolTip="Sobre o TeclaScore" AutomationProperties.Name="Sobre o TeclaScore" Padding="10,10" HorizontalContentAlignment="{Binding SidebarContentAlignment}">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="about"><Setter Property="Background" Value="{DynamicResource SidebarActive}"/><Setter Property="Foreground" Value="{DynamicResource SidebarInk}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     <StackPanel Orientation="Horizontal"><TextBlock Text="ⓘ" FontFamily="Segoe UI Symbol" FontSize="20" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Sobre" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding ExpandedSidebarVisible}"/></StackPanel>
    </Button>
   </StackPanel>
   </ScrollViewer><StackPanel Grid.Row="2">
    <StackPanel Visibility="{Binding ExpandedSidebarVisible}"><Border Background="{DynamicResource SidebarPanel}" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="SEU PADRÃO MUSICAL" Foreground="{DynamicResource SidebarMuted}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="Melodia + cifras" Foreground="{DynamicResource SidebarInk}" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="Diagramas de teclado&#10;Inversão configurável" Foreground="{DynamicResource SidebarMuted}" FontSize="12" LineHeight="20"/></StackPanel></Border><TextBlock Text="●  Local no seu computador" Foreground="{DynamicResource SidebarMuted}" FontSize="10" Margin="9,20,0,0"/><TextBlock Text="{Binding AppVersionLabel}" Foreground="{DynamicResource SidebarMuted}" FontSize="9" Margin="9,7,0,0"/></StackPanel>
    <Button x:Name="SidebarToggle" Click="ToggleSidebarClick" ToolTip="{Binding SidebarToggleLabel}" AutomationProperties.Name="{Binding SidebarToggleLabel}" Style="{StaticResource NavButton}" Foreground="{DynamicResource SidebarInk}" Background="{DynamicResource SidebarPanel}" HorizontalAlignment="{Binding SidebarContentAlignment}" HorizontalContentAlignment="Center" Padding="0" Width="32" Height="32" MinHeight="32" Margin="0,16,0,0">
     <Path Width="18" Height="16" Data="M 4,3 L 16,3 M 2,8 L 16,8 M 8,13 L 16,13" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><ScaleTransform ScaleX="{Binding SidebarToggleScaleX}"/></Path.RenderTransform></Path>
    </Button>
   </StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="116"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
   <Border x:Name="WorkspaceDragRegion" Background="Transparent"><Grid x:Name="WorkspaceHeader" Margin="28,22,28,18" IsEnabled="{Binding IsIdle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TECLASCORE  /  ESPAÇO DE TRABALHO" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding PageTitle}" TextTrimming="CharacterEllipsis" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock Text="{Binding PageSubtitle}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"><Button x:Name="PdfExportButton" Content="Salvar PDF" Click="ExportPdfClick" ToolTip="Salvar todas as páginas em PDF (Ctrl+P)" IsEnabled="{Binding CanExportPdf}" MinWidth="160" Height="40" Margin="0,0,8,0" Visibility="{Binding LibraryVisible}" AutomationProperties.Name="Salvar todas as páginas em PDF"/><Button Content="Importar MuseScore" Click="ImportMuseScoreClick" MinWidth="160" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" ToolTip="Abrir .mscz para melhorar apresentação e comparar versões (Ctrl+Shift+O)"/><Button x:Name="MidiFolderButton" Content="＋  Pasta de MIDIs" Click="OpenMidiFolderClick" MinWidth="160" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsIdle}" ToolTip="Abrir uma pasta e escolher, dentro do app, quais MIDIs entram na biblioteca. Nada é copiado (Ctrl+L). Para arquivos avulsos, use Escolher arquivos na janela, arraste-os para o app ou Ctrl+O." AutomationProperties.Name="Pasta de MIDIs"/></StackPanel></Grid>
</Border>
   <Grid x:Name="WorkspacePages" Grid.Row="1" Margin="28,6,28,22" IsEnabled="{Binding IsIdle}">
    <ScrollViewer Visibility="{Binding DashboardVisible}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Border CornerRadius="15" Padding="26,20" Margin="0,0,0,18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource HeroStartColor}" Offset="0"/><GradientStop Color="{DynamicResource HeroEndColor}" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DA SUA BIBLIOTECA PARA O TECLADO" Foreground="{DynamicResource HeroMuted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Seu repertório, pronto para tocar." Foreground="{DynamicResource HeroInk}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,7"/><TextBlock Text="{Binding DashboardMessage}" Foreground="{DynamicResource HeroMuted}" TextWrapping="Wrap" FontSize="12" MaxWidth="650" HorizontalAlignment="Left"/></StackPanel><Border Grid.Column="1" CornerRadius="10" Background="{DynamicResource HeroPanel}" Padding="16,12" Margin="20,0,0,0"><StackPanel><TextBlock Text="MELODIA   ·   CIFRAS   ·   TECLAS" Foreground="{DynamicResource HeroMuted}" FontSize="8" HorizontalAlignment="Center"/><Grid Height="58" Width="166" Margin="0,9,0,0"><UniformGrid Columns="10"><Border Background="{DynamicResource KeyboardWhite}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardWhite}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardActive}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardWhite}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardActive}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardWhite}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardWhite}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardActive}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardWhite}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardWhite}" CornerRadius="0,0,2,2"/></UniformGrid><Canvas><Rectangle Canvas.Left="12" Width="8" Height="35" Fill="{DynamicResource KeyboardBlack}"/><Rectangle Canvas.Left="29" Width="8" Height="35" Fill="{DynamicResource KeyboardBlack}"/><Rectangle Canvas.Left="62" Width="8" Height="35" Fill="{DynamicResource KeyboardBlack}"/><Rectangle Canvas.Left="79" Width="8" Height="35" Fill="{DynamicResource KeyboardBlack}"/><Rectangle Canvas.Left="95" Width="8" Height="35" Fill="{DynamicResource KeyboardBlack}"/><Rectangle Canvas.Left="129" Width="8" Height="35" Fill="{DynamicResource KeyboardBlack}"/><Rectangle Canvas.Left="145" Width="8" Height="35" Fill="{DynamicResource KeyboardBlack}"/></Canvas></Grid></StackPanel></Border></Grid></Border>
     <UniformGrid Columns="4" Margin="0,0,-12,18">
      <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,15"><StackPanel><TextBlock Text="Arquivos na biblioteca" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricValue}"/><Button Content="Ver biblioteca  →" Tag="all" Click="FilterClick" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="22" HorizontalAlignment="Left" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,15"><StackPanel><TextBlock Text="Prontos para o lote" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding ReadyCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource Ready}"/><Button Content="Perfis revisados  →" Tag="ready" Click="FilterClick" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="22" HorizontalAlignment="Left" FontSize="11" Foreground="{DynamicResource Ready}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,15"><StackPanel><TextBlock Text="Partituras geradas" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding GeneratedCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource Generated}"/><Button Content="Ver resultados  →" Tag="production" Click="NavigationClick" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="22" HorizontalAlignment="Left" FontSize="11" Foreground="{DynamicResource Generated}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,15"><StackPanel><TextBlock Text="Revisão musical" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding ReviewCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource Review}"/><Button Content="Conferir melodia  →" Tag="review" Click="FilterClick" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="22" HorizontalAlignment="Left" FontSize="11" Foreground="{DynamicResource Review}"/></StackPanel></Border>
     </UniformGrid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Situação da biblioteca" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Distribuição dos arquivos da sua biblioteca" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,18"/>
       <DockPanel><TextBlock Text="{Binding ReadyCount}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="Prontos para gerar"/></DockPanel><ProgressBar Style="{StaticResource ChartBar}" Value="{Binding ReadyPercent,Mode=OneWay}" Foreground="{DynamicResource Ready}" Margin="0,9,0,16"/>
       <DockPanel><TextBlock Text="{Binding GeneratedCount}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="Partituras geradas"/></DockPanel><ProgressBar Style="{StaticResource ChartBar}" Value="{Binding GeneratedPercent,Mode=OneWay}" Foreground="{DynamicResource Generated}" Margin="0,9,0,16"/>
       <DockPanel><TextBlock Text="{Binding ReviewCount}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="Precisam de revisão musical"/></DockPanel><ProgressBar Style="{StaticResource ChartBar}" Value="{Binding ReviewPercent,Mode=OneWay}" Foreground="{DynamicResource Review}" Margin="0,9,0,16"/>
       <DockPanel><TextBlock Text="{Binding ErrorCount}" DockPanel.Dock="Right" FontWeight="SemiBold"/><Button Content="Falhas de leitura ou conversão  →" Tag="error" Click="FilterClick" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="20" HorizontalContentAlignment="Left" FontWeight="Normal"/></DockPanel><ProgressBar Style="{StaticResource ChartBar}" Value="{Binding ErrorPercent,Mode=OneWay}" Foreground="{DynamicResource Error}" Margin="0,9,0,0"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><DockPanel><Button Content="Ver todas  →" Tag="all" Click="FilterClick" DockPanel.Dock="Right" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Accent}" Padding="0" MinHeight="22" FontSize="11"/><TextBlock Text="Últimas importações" FontSize="17" FontWeight="SemiBold"/></DockPanel><TextBlock Text="Abra uma música para continuar a preparação" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,12"/>
       <ItemsControl ItemsSource="{Binding RecentFiles}"><ItemsControl.ItemTemplate><DataTemplate><Button Click="OpenEditorClick" Tag="{Binding}" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}" Padding="0,10" HorizontalContentAlignment="Stretch" FontWeight="Normal"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Soft}" CornerRadius="7" Width="27" Height="32" HorizontalAlignment="Left"><TextBlock Text="♪" FontSize="19" Foreground="{DynamicResource SoftInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding CategoryLabel}" Foreground="{Binding CategoryColor}" FontSize="11" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="→" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <StackPanel Visibility="{Binding DashboardEmptyVisible}" Margin="0,28,0,26"><TextBlock Text="Sua próxima música começa aqui." FontWeight="SemiBold"/><TextBlock Text="Importe arquivos .mid, .midi ou .kar. Você também pode arrastá-los para a janela." Style="{StaticResource MutedText}" Margin="0,8,0,14"/><WrapPanel><Button Content="Adicionar minhas músicas" Click="ImportClick" Style="{StaticResource SoftButton}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,6"/><Button Content="Escolher de uma pasta" Click="OpenMidiFolderClick" IsEnabled="{Binding IsIdle}" Margin="0,0,0,6" ToolTip="Ver os MIDIs de uma pasta e escolher quais adicionar, sem copiar"/></WrapPanel></StackPanel>
      </StackPanel></Border>
     </Grid>
     <Border Background="{DynamicResource Soft}" CornerRadius="12" Padding="20,16" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tudo pronto para o próximo lote?" FontWeight="SemiBold"/><TextBlock Text="Use os perfis musicais revisados para preparar várias partituras de uma vez." FontSize="12" Foreground="{DynamicResource SoftInk}" Margin="0,4,16,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Enfileirar lote revisado  →" Click="BatchClick" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanBatch}" VerticalAlignment="Center"/></Grid></Border>
    </StackPanel></ScrollViewer>
    <Grid Visibility="{Binding LibraryVisible}"><Grid.ColumnDefinitions><ColumnDefinition Width="264"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="12"><Grid x:Name="LibrarySplitPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="LibraryFiltersRow" Height="55*" MinHeight="96"/><RowDefinition Height="14"/><RowDefinition x:Name="LibraryCardsRow" Height="45*" MinHeight="150"/></Grid.RowDefinitions><Button x:Name="ClearLibraryButton" Grid.Row="0" Content="Limpar biblioteca" Click="ClearLibraryClick" IsEnabled="{Binding CanClearLibrary}" Foreground="{DynamicResource Error}" HorizontalAlignment="Right" Padding="10,6" MinHeight="30" FontSize="11" Margin="0,0,0,6" ToolTip="Remover todos os cards, preservando os arquivos no computador"/><ScrollViewer x:Name="LibraryFiltersScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,4,4,12"><TextBlock Text="Seu repertório" FontSize="17" FontWeight="SemiBold"/><WrapPanel Margin="0,10,0,10"><Button Content="Pasta de MIDIs" Click="OpenMidiFolderClick" IsEnabled="{Binding IsIdle}" Margin="0,0,8,6" ToolTip="Escolher MIDIs de uma pasta, sem copiar (Ctrl+L)"/><Button x:Name="MelodyBatchButton" Content="Melodias em lote" Click="MelodyBatchClick" IsEnabled="{Binding IsIdle}" Margin="0,0,8,6" ToolTip="Escolher automaticamente a melodia dos MIDIs ainda sem escolha (só as claras vêm marcadas) e mandar para a Fila de conversões" AutomationProperties.Name="Escolher melodias em lote"/><Button x:Name="LibraryBatchPdfButton" Content="PDFs em massa" Click="ExportBatchPdfClick" IsEnabled="{Binding CanExportBatchPdf}" Margin="0,0,8,6" ToolTip="Marcar os cards com partitura gerada e salvar um PDF de cada, direto na pasta escolhida" AutomationProperties.Name="Salvar PDFs em massa"/><Button x:Name="RepertoirePdfButton" Content="Repertório em PDF" Click="RepertoirePdfClick" IsEnabled="{Binding CanExportBatchPdf}" Margin="0,0,8,6" ToolTip="Juntar as partituras marcadas em um único PDF, com índice, marcadores para o tablet e, se quiser, os acordes de cada música" AutomationProperties.Name="Montar repertório em PDF"/><Button x:Name="ConversionQueueButton" Content="Fila de conversões" Click="ConversionQueueClick" IsEnabled="{Binding IsIdle}" Margin="0,0,0,6"/></WrapPanel><TextBlock Text="Buscar nome, autor, acorde ou tom" Style="{StaticResource Eyebrow}" Margin="0,14,0,5"/><TextBox x:Name="LibrarySearchBox" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome, título, autor, coleção ou gênero; também cifras (F#dim, Am7) e tom (Dm, Ré menor). As palavras se somam: forró Dm. Ctrl+F" AutomationProperties.Name="Buscar por nome, título, autor ou gênero" IsEnabled="{Binding IsIdle}"/><CheckBox Content="★ Somente favoritos" IsChecked="{Binding FavoritesOnly}" IsEnabled="{Binding IsIdle}" Margin="0,12,0,8"/><TextBlock Text="Coleção / repertório (vazio: todas)" FontSize="10" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding LibraryCollections}" SelectedItem="{Binding CollectionFilter,Mode=TwoWay}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Filtrar coleção"/><WrapPanel Margin="0,10,0,0" IsEnabled="{Binding IsIdle}"><Button Content="Todos" Tag="all" Click="FilterClick" FontSize="11" Padding="10,6" MinHeight="28" Margin="0,0,5,5"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentFilter}" Value="all"><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="BorderBrush" Value="{DynamicResource SelectionBorder}"/><Setter Property="Foreground" Value="{DynamicResource SoftInk}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Prontos" Tag="ready" Click="FilterClick" FontSize="11" Padding="10,6" MinHeight="28" Margin="0,0,5,5"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentFilter}" Value="ready"><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="BorderBrush" Value="{DynamicResource SelectionBorder}"/><Setter Property="Foreground" Value="{DynamicResource SoftInk}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Revisar" Tag="review" Click="FilterClick" FontSize="11" Padding="10,6" MinHeight="28" Margin="0,0,5,5"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentFilter}" Value="review"><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="BorderBrush" Value="{DynamicResource SelectionBorder}"/><Setter Property="Foreground" Value="{DynamicResource SoftInk}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Gerados" Tag="generated" Click="FilterClick" FontSize="11" Padding="10,6" MinHeight="28" Margin="0,0,5,5"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentFilter}" Value="generated"><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="BorderBrush" Value="{DynamicResource SelectionBorder}"/><Setter Property="Foreground" Value="{DynamicResource SoftInk}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Falhas" Tag="error" Click="FilterClick" FontSize="11" Padding="10,6" MinHeight="28" Margin="0,0,5,5"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentFilter}" Value="error"><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="BorderBrush" Value="{DynamicResource SelectionBorder}"/><Setter Property="Foreground" Value="{DynamicResource SoftInk}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel><TextBlock Text="{Binding FilterLabel}" FontWeight="SemiBold" FontSize="11" Margin="0,6,0,0"/><TextBlock Text="{Binding LibraryCoun