    <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding SidebarContentAlignment}"><Image Source="Assets/teclas.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="TeclaScore"/><TextBlock Text="{Binding AppDisplayName}" Foreground="{DynamicResource SidebarInk}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding ExpandedSidebarVisible}"/></StackPanel>
    <TextBlock Text="ESTÚDIO DE PARTITURAS" Foreground="{DynamicResource SidebarMuted}" FontSize="9" FontWeight="SemiBold" Margin="8,13,0,0" Visibility="{Binding ExpandedSidebarVisible}"/>
   </StackPanel>
   <ScrollViewer Grid.Row="1" Margin="0,32,0,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SidebarMenu"><TextBlock Text="SEU ESPAÇO" Foreground="{DynamicResource SidebarMuted}" FontSize="10" Margin="12,0,0,14" Visibility="{Binding ExpandedSidebarVisible}"/>
