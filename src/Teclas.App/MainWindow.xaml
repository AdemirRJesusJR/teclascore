<Window x:Class="Teclas.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Teclas.App" Title="TeclaScore" Width="1400" Height="960" MinWidth="1100" MinHeight="740" Background="{DynamicResource Background}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" AllowDrop="True" Drop="FilesDrop">
 <Grid Background="{DynamicResource Background}">
 <Grid x:Name="WorkspaceContent">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.Resources>
   <BooleanToVisibilityConverter x:Key="BoolVisible"/>
   <Style x:Key="TopNav" TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource SoftInk}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="40"/><Setter Property="MinWidth" Value="44"/><Setter Property="Padding" Value="10,3"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Pill" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/><Border x:Name="Hover" CornerRadius="9" Background="{DynamicResource Soft}" Opacity="0"/><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style x:Key="TopNavUtility" TargetType="Button" BasedOn="{StaticResource TopNav}"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="MinWidth" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,2,0"/></Style>
   <Style x:Key="TopNavIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="18"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
   <Style x:Key="TopNavLabel" TargetType="TextBlock"><Setter Property="Margin" Value="9,0,0,0"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Visibility" Value="{Binding DataContext.NavLabelVisibility,RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/></Style>
   <Style x:Key="TopNavStackedLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,2,0,0"/><Setter Property="FontSize" Value="10.5"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Visibility" Value="{Binding DataContext.NavStackedLabelVisibility,RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/></Style>
   <Style x:Key="HeaderAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="12"/></Style>
   <Style x:Key="IconButton" TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource SoftInk}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Box" CornerRadius="8" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Soft}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style x:Key="FactChip" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Soft}"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="8,2"/><Setter Property="Margin" Value="0,0,6,4"/></Style>
   <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
   <Style x:Key="SectionLead" TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{DynamicResource SoftInk}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
   <Style x:Key="SwitchCheckBox" TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/><Border x:Name="Track" Grid.Column="1" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource InputBorder}" VerticalAlignment="Center"><Ellipse x:Name="Knob" Width="14" Height="14" Fill="{DynamicResource CardBrush}" HorizontalAlignment="Left" Margin="3,0"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentInk}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
     <DataTemplate x:Key="FlowCheckTemplate"><Grid Margin="0,0,0,5"><Border x:Name="Tint" CornerRadius="9" Background="{DynamicResource Review}" Opacity="0.13"/><DockPanel Margin="10,6,10,6"><TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Review}" VerticalAlignment="Top" Margin="0,2,10,0"/><WrapPanel DockPanel.Dock="Bottom" Margin="0,5,0,0"><Button Content="{Binding ActionLabel}" Tag="{Binding}" Click="FlowActionClick" Visibility="{Binding ActionVisibility}" IsEnabled="{Binding DataContext.IsIdle,RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Padding="9,0" Height="26" MinHeight="26" FontSize="11" Margin="0,0,6,0"/><Button Content="{Binding ConfirmLabel}" Tag="{Binding}" Click="FlowConfirmClick" Visibility="{Binding ConfirmVisibility}" Style="{StaticResource SoftButton}" Padding="9,0" Height="26" MinHeight="26" FontSize="11" Margin="0,0,6,0" ToolTip="Confirmar e seguir"/><Button Content="Desfazer" Tag="{Binding}" Click="FlowUndoClick" Visibility="{Binding UndoVisibility}" Padding="9,0" Height="26" MinHeight="26" FontSize="11" ToolTip="Desfazer a confirmação"/></WrapPanel><TextBlock x:Name="Message" Text="{Binding Message}" ToolTip="{Binding Message}" TextWrapping="Wrap" MaxHeight="50" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/></DockPanel></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding Level}" Value="block"><Setter TargetName="Tint" Property="Background" Value="{DynamicResource Error}"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Error}"/></DataTrigger><DataTrigger Binding="{Binding Level}" Value="done"><Setter TargetName="Tint" Property="Background" Value="{DynamicResource Ready}"/><Setter TargetName="Tint" Property="Opacity" Value="0.10"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Ready}"/><Setter TargetName="Message" Property="Foreground" Value="{DynamicResource SoftInk}"/></DataTrigger></DataTemplate.Triggers></DataTemplate>
  </Grid.Resources>
  <Border x:Name="WorkspaceSidebar" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" IsEnabled="{Binding IsIdle}">
   <Border x:Name="WorkspaceDragRegion" Background="Transparent">
    <Grid x:Name="WorkspaceHeader" Height="60" Margin="20,0,16,0" IsEnabled="{Binding IsIdle}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/teclas.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="TeclaScore"/><TextBlock Text="{Binding AppDisplayName}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,1" Visibility="{Binding CommandBoxTextVisibility}"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
      <StackPanel x:Name="SidebarMenu" Orientation="Horizontal">
       <Border Background="{DynamicResource Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
        <Button Tag="dashboard" Click="NavigationClick" ToolTip="Visão geral (Ctrl+1)" AutomationProperties.Name="Visão geral"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopNav}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="dashboard"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE80F;" Style="{StaticResource TopNavIcon}"/><TextBlock Text="Início" Style="{StaticResource TopNavLabel}"/></StackPanel><TextBlock Text="Início" Style="{StaticResource TopNavStackedLabel}"/></StackPanel></Button>
        <Button Tag="library" Click="NavigationClick" ToolTip="Biblioteca (Ctrl+2)" AutomationProperties.Name="Biblioteca"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopNav}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="library"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE8F1;" Style="{StaticResource TopNavIcon}"/><TextBlock Text="Biblioteca" Style="{StaticResource TopNavLabel}"/></StackPanel><TextBlock Text="Biblioteca" Style="{StaticResource TopNavStackedLabel}"/></StackPanel></Button>
        <Button Tag="production" Click="NavigationClick" ToolTip="Produção: fila de conversões e partituras geradas (Ctrl+3)" AutomationProperties.Name="Produção"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopNav}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="production"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xF0E3;" Style="{StaticResource TopNavIcon}"/><TextBlock Text="Produção" Style="{StaticResource TopNavLabel}"/></StackPanel><TextBlock Text="Produção" Style="{StaticResource TopNavStackedLabel}"/></StackPanel></Button>
        <Button x:Name="PresentationButton" Click="OpenPresentationClick" IsEnabled="{Binding CanOpenPresentation}" ToolTip="Modo apresentação (palco)" AutomationProperties.Name="Modo apresentação" Style="{StaticResource TopNav}"><StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE786;" Style="{StaticResource TopNavIcon}"/><TextBlock Text="Apresentação" Style="{StaticResource TopNavLabel}"/></StackPanel><TextBlock Text="Apresentação" Style="{StaticResource TopNavStackedLabel}"/></StackPanel></Button>
       </StackPanel></Border>
       <Border Width="1" Height="26" Background="{DynamicResource Line}" Margin="10,0,6,0" VerticalAlignment="Center"/>
       <Button x:Name="RecoverDraftsButton" Click="OpenDraftRecoveryClick" IsEnabled="{Binding CanRecoverDrafts}" ToolTip="Recuperar rascunhos do Editor musical" AutomationProperties.Name="Recuperar rascunhos" Style="{StaticResource TopNavUtility}"><TextBlock Text="&#xE81C;" Style="{StaticResource TopNavIcon}"/></Button>
       <Button Tag="settings" Click="NavigationClick" ToolTip="Configurações (Ctrl+,)" AutomationProperties.Name="Configurações"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopNavUtility}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="settings"><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="&#xE713;" Style="{StaticResource TopNavIcon}"/></Button>
       <Button Tag="about" Click="NavigationClick" ToolTip="Sobre o TeclaScore" AutomationProperties.Name="Sobre o TeclaScore"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopNavUtility}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="about"><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="&#xE946;" Style="{StaticResource TopNavIcon}"/></Button>
      </StackPanel>
      <Button x:Name="SidebarToggle" Click="ToggleSidebarClick" ToolTip="{Binding SidebarToggleLabel}" AutomationProperties.Name="{Binding SidebarToggleLabel}" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="2,0,0,0" Content="&#xE700;" FontSize="13"/>
     </StackPanel>
     <TextBlock Grid.Column="2" Text="{Binding PageTitle}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="14,0,10,0" TextTrimming="CharacterEllipsis"/>
     <Button x:Name="CommandPaletteButton" Grid.Column="3" Click="CommandPaletteClick" Height="36" MinWidth="40" Margin="0,0,10,0" Cursor="Hand" ToolTip="Comandos (Ctrl+K): digite o nome de qualquer ação ou música" AutomationProperties.Name="Comandos"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Box" CornerRadius="9" Background="{DynamicResource Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,0,6,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock Text="Buscar ou executar um comando" Foreground="{DynamicResource Muted}" FontSize="12" Margin="8,0,24,0" VerticalAlignment="Center" Visibility="{Binding CommandBoxTextVisibility}"/><Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="6,0,0,0" Background="{DynamicResource CardBrush}"><TextBlock Text="Ctrl K" FontSize="10.5" Foreground="{DynamicResource SoftInk}"/></Border></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SelectionBorder}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
     <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="UpdateAvailableButton" Content="{Binding UpdateButtonText}" Visibility="{Binding UpdateButtonVisibility}" Click="InstallUpdateClick" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Height="36" MinHeight="36" Padding="12,0" FontSize="12" ToolTip="Baixar o instalador oficial, conferir o SHA-256 e instalar a nova versão" AutomationProperties.Name="Atualizar o TeclaScore"/><Button x:Name="PdfExportButton" Content="Salvar PDF" Click="ExportPdfClick" ToolTip="Salvar todas as páginas em PDF (Ctrl+P)" IsEnabled="{Binding CanExportPdf}" Width="138" Style="{StaticResource HeaderAction}" Margin="0,0,8,0" Visibility="{Binding LibraryVisible}" AutomationProperties.Name="Salvar todas as páginas em PDF"/><Button Content="Importar MuseScore" Click="ImportMuseScoreClick" Width="138" Style="{StaticResource HeaderAction}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" ToolTip="Abrir .mscz para melhorar apresentação e comparar versões (Ctrl+Shift+O)"/><Button x:Name="MidiFolderButton" Content="＋  Pasta de MIDIs" Click="OpenMidiFolderClick" Height="36" MinHeight="36" Padding="14,0" FontSize="12" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsIdle}" ToolTip="Abrir uma pasta e escolher, dentro do app, quais MIDIs entram na biblioteca. Nada é copiado (Ctrl+L). Para arquivos avulsos, use Escolher arquivos na janela, arraste-os para o app ou Ctrl+O." AutomationProperties.Name="Pasta de MIDIs"/></StackPanel>
    </Grid>
   </Border>
  </Border>
   <Grid x:Name="WorkspacePages" Grid.Row="1" Margin="20,16,20,16" IsEnabled="{Binding IsIdle}">
    <ScrollViewer Visibility="{Binding DashboardVisible}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Border CornerRadius="15" Padding="26,20" Margin="0,0,0,18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource HeroStartColor}" Offset="0"/><GradientStop Color="{DynamicResource HeroEndColor}" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DA SUA BIBLIOTECA PARA O TECLADO" Foreground="{DynamicResource HeroMuted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Seu repertório, pronto para tocar." Foreground="{DynamicResource HeroInk}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,7"/><TextBlock Text="{Binding DashboardMessage}" Foreground="{DynamicResource HeroMuted}" TextWrapping="Wrap" FontSize="12" MaxWidth="650" HorizontalAlignment="Left"/></StackPanel><Border Grid.Column="1" CornerRadius="10" Background="{DynamicResource HeroPanel}" Padding="16,12" Margin="20,0,0,0"><StackPanel><TextBlock Text="MELODIA   ·   CIFRAS   ·   TECLAS" Foreground="{DynamicResource HeroMuted}" FontSize="8" HorizontalAlignment="Center"/><Grid Height="58" Width="166" Margin="0,9,0,0"><UniformGrid Columns="10"><Border Background="{DynamicResource KeyboardWhite}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardWhite}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardActive}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardWhite}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardActive}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardWhite}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardWhite}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardActive}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardWhite}" Margin="0,0,1,0" CornerRadius="0,0,2,2"/><Border Background="{DynamicResource KeyboardWhite}" CornerRadius="0,0,2,2"/></UniformGrid><Canvas><Rectangle Canvas.Left="12" Width="8" Height="35" Fill="{DynamicResource KeyboardBlack}"/><Rectangle Canvas.Left="29" Width="8" Height="35" Fill="{DynamicResource KeyboardBlack}"/><Rectangle Canvas.Left="62" Width="8" Height="35" Fill="{DynamicResource KeyboardBlack}"/><Rectangle Canvas.Left="79" Width="8" Height="35" Fill="{DynamicResource KeyboardBlack}"/><Rectangle Canvas.Left="95" Width="8" Height="35" Fill="{DynamicResource KeyboardBlack}"/><Rectangle Canvas.Left="129" Width="8" Height="35" Fill="{DynamicResource KeyboardBlack}"/><Rectangle Canvas.Left="145" Width="8" Height="35" Fill="{DynamicResource KeyboardBlack}"/></Canvas></Grid></StackPanel></Border></Grid></Border>
     <UniformGrid Columns="4" Margin="0,0,-12,18">
      <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,15"><StackPanel><TextBlock Text="Arquivos na biblioteca" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricValue}"/><Button Content="Ver biblioteca  →" Tag="all" Click="FilterClick" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="22" HorizontalAlignment="Left" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,15"><StackPanel><TextBlock Text="Prontos para o lote" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding ReadyCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource Ready}"/><Button Content="Perfis revisados  →" Tag="ready" Click="FilterClick" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="22" HorizontalAlignment="Left" FontSize="11" Foreground="{DynamicResource Ready}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,15"><StackPanel><TextBlock Text="Partituras geradas" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding GeneratedCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource Generated}"/><Button Content="Ver resultados  →" Tag="production" Click="NavigationClick" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="22" HorizontalAlignment="Left" FontSize="11" Foreground="{DynamicResource Generated}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,15"><StackPanel><TextBlock Text="Revisão musical" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding ReviewCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource Review}"/><Button Content="Conferir melodia  →" Tag="review" Click="FilterClick" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="22" HorizontalAlignment="Left" FontSize="11" Foreground="{DynamicResource Review}"/></StackPanel></Border>
     </UniformGrid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Situação da biblioteca" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Distribuição dos arquivos da sua biblioteca" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,18"/>
       <DockPanel><TextBlock Text="{Binding ReadyCount}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="Prontos para gerar"/></DockPanel><ProgressBar Style="{StaticResource ChartBar}" Value="{Binding ReadyPercent,Mode=OneWay}" Foreground="{DynamicResource Ready}" Margin="0,9,0,16"/>
       <DockPanel><TextBlock Text="{Binding GeneratedCount}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="Partituras geradas"/></DockPanel><ProgressBar Style="{StaticResource ChartBar}" Value="{Binding GeneratedPercent,Mode=OneWay}" Foreground="{DynamicResource Generated}" Margin="0,9,0,16"/>
       <DockPanel><TextBlock Text="{Binding ReviewCount}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="Precisam de revisão musical"/></DockPanel><ProgressBar Style="{StaticResource ChartBar}" Value="{Binding ReviewPercent,Mode=OneWay}" Foreground="{DynamicResource Review}" Margin="0,9,0,16"/>
       <DockPanel><TextBlock Text="{Binding ErrorCount}" DockPanel.Dock="Right" FontWeight="SemiBold"/><Button Content="Falhas de leitura ou conversão  →" Tag="error" Click="FilterClick" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="20" HorizontalContentAlignment="Left" FontWeight="Normal"/></DockPanel><ProgressBar Style="{StaticResource ChartBar}" Value="{Binding ErrorPercent,Mode=OneWay}" Foreground="{DynamicResource Error}" Margin="0,9,0,0"/><Button x:Name="RetryFailuresButton" Content="Tentar de novo com ajuste" Click="RetryFailuresClick" IsEnabled="{Binding IsIdle}" Visibility="{Binding RetryFailuresVisibility}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4" FontSize="12" ToolTip="Gera de novo as músicas que falharam: primeiro sem dobrar as repetições, depois só com cifras; mostra o que precisou mudar" AutomationProperties.Name="Tentar de novo as falhas com ajuste"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><DockPanel><Button Content="Ver todas  →" Tag="all" Click="FilterClick" DockPanel.Dock="Right" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Accent}" Padding="0" MinHeight="22" FontSize="11"/><TextBlock Text="Últimas importações" FontSize="17" FontWeight="SemiBold"/></DockPanel><TextBlock Text="Abra uma música para continuar a preparação" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,12"/>
       <ItemsControl ItemsSource="{Binding RecentFiles}"><ItemsControl.ItemTemplate><DataTemplate><Button Click="OpenEditorClick" Tag="{Binding}" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}" Padding="0,10" HorizontalContentAlignment="Stretch" FontWeight="Normal"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Soft}" CornerRadius="7" Width="27" Height="32" HorizontalAlignment="Left"><TextBlock Text="♪" FontSize="19" Foreground="{DynamicResource SoftInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding CategoryLabel}" Foreground="{Binding CategoryColor}" FontSize="11" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="→" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <StackPanel Visibility="{Binding DashboardEmptyVisible}" Margin="0,28,0,26"><TextBlock Text="Sua próxima música começa aqui." FontWeight="SemiBold"/><TextBlock Text="Importe arquivos .mid, .midi ou .kar. Você também pode arrastá-los para a janela." Style="{StaticResource MutedText}" Margin="0,8,0,14"/><WrapPanel><Button Content="Adicionar minhas músicas" Click="ImportClick" Style="{StaticResource SoftButton}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,6"/><Button Content="Escolher de uma pasta" Click="OpenMidiFolderClick" IsEnabled="{Binding IsIdle}" Margin="0,0,0,6" ToolTip="Ver os MIDIs de uma pasta e escolher quais adicionar, sem copiar"/></WrapPanel></StackPanel>
