<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org, and only for the official Anthropic SDK (professor com IA), its Microsoft/System dependencies and the
       .NET runtime packs used by the self-contained publish. Anything else fails to restore. -->
  <packageSources><clear /><add key="nuget.org" value="https://api.nuget.org/v3/index.json" /></packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Anthropic" />
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
